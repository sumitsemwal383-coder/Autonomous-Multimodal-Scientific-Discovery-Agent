FROM python:3.11-slim

RUN groupadd -r sandboxuser && useradd -r -g sandboxuser -u 1001 sandboxuser

RUN pip install --no-cache-dir \
    numpy==1.26.4 \
    scipy==1.12.0 \
    pandas==2.2.1 \
    scikit-learn==1.4.1.post1 \
    matplotlib==3.8.3

WORKDIR /app

RUN chown -R sandboxuser:sandboxuser /app

USER sandboxuser

CMD ["python", "--version"]
